# Numero do WhatsApp que vai controlar o bot, somente digitos com DDI.
# Exemplo Brasil: 5511999999999
ADMIN_NUMBER=5511999999999

# Credenciais iniciais do painel. Troque antes de usar em producao.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha
SESSION_SECRET=troque-por-uma-string-longa-e-aleatoria

# Local: deixe vazio para usar SQLite na pasta do projeto.
# Railway: use o caminho do Volume persistente.
STORAGE_DIR=

# Railway injeta DATABASE_URL automaticamente quando PostgreSQL esta conectado.
# DATABASE_URL=
# PORT=3000
