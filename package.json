{
  "name": "bot-wap",
  "version": "1.0.0",
  "private": true,
  "description": "Bot WhatsApp que encaminha mensagens de clientes para o seu numero, permite assumir a conversa manualmente com !assumir, e conta com uma dashboard web para acompanhar tudo.",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "node scripts/build-site.cjs",
    "start": "node server.js",
    "bot-only": "node index.js",
    "test": "node --test",
    "test:ui": "node scripts/check-pages.cjs",
    "test:access": "node scripts/check-access.cjs",
    "test:login": "node scripts/check-login.cjs",
    "test:inbox": "node scripts/check-inbox.cjs",
    "test:chips": "node scripts/check-chips.cjs",
    "test:multi-chip": "node scripts/check-multi-chip.cjs"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.9",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-session": "^1.19.0",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "pino": "^9.3.2",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.8.4",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0"
  }
}
