{
  "name": "convelya",
  "version": "1.0.0",
  "private": true,
  "description": "Convelya organiza conversas, equipe e resultados em um só lugar.",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "node scripts/build-site.cjs",
    "start": "node server.js",
    "bot-only": "node index.js",
    "test": "node --test",
    "test:flows": "node --test test/flow-engine.test.js test/flow-branches.test.js test/flow-edge-cases.test.js test/flow-service-audit.test.js test/flow-restart.test.js test/flow-whatsapp.test.js test/flows.test.js test/whatsapp-outgoing.test.js test/whatsapp-message-retry.test.js",
    "test:flows:ui": "node scripts/check-flows.cjs",
    "test:flows:audit": "node scripts/check-flows-audit.cjs",
    "test:flows:postgres": "node scripts/check-flows-postgres.cjs",
    "test:flows:handoff": "node scripts/check-flow-handoff.cjs",
    "test:connection": "node --test test/connection-lifecycle.test.js test/worker-lifecycle.test.js test/bot-manager-lifecycle.test.js test/storage-path.test.js",
    "check:storage": "node scripts/check-storage.cjs",
    "test:history": "node --test test/whatsapp-history.test.js",
    "test:ui": "node scripts/check-pages.cjs",
    "test:dashboard": "node scripts/check-dashboard.cjs",
    "test:funnels": "node scripts/check-funnels.cjs",
    "test:modals": "node scripts/check-modals.cjs",
    "test:message-scroll": "node scripts/check-message-scroll.cjs",
    "test:access": "node scripts/check-access.cjs",
    "test:login": "node scripts/check-login.cjs",
    "test:inbox": "node scripts/check-inbox.cjs",
    "test:chips": "node scripts/check-chips.cjs",
    "test:multi-chip": "node scripts/check-multi-chip.cjs"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.9",
    "@xyflow/react": "^12.12.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "express-session": "^1.19.0",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "pino": "^9.3.2",
    "prismjs": "^1.30.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "quickjs-emscripten": "^0.32.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.8.4",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0"
  }
}
